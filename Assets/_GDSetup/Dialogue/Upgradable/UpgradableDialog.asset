  SequenceID: upgradable_master
  Lines:
  - CharacterName: "\u041C\u0430\u0441\u0442\u0435\u0440"
    Text: "\u0423 \u0442\u0435\u0431\u044F \u0442\u0430\u043A\u0438\u0435 \u0445\u0438\u043B\u044B\u0435
      \u043A\u0430\u0440\u0442\u044B, \u043A\u0430\u043A \u0442\u044B \u0435\u0449\u0435
      \u0436\u0438\u0432\u0435\u0448\u044C?"
    DisplayTime: 2
    IsPlayerLine: 0
  - CharacterName: "\u0418\u0433\u0440\u043E\u043A"
    Text: "\u0418 \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0432\u0435\u0442...
      \u0410 \u0447\u0442\u043E \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C?"
    DisplayTime: 1.5
    IsPlayerLine: 1
  - CharacterName: "\u041C\u0430\u0441\u0442\u0435\u0440"
    Text: "\u041D\u0443 \u0435\u0441\u043B\u0438 \u0442\u044B \u0434\u0430\u0448\u044C
      \u043C\u043D\u0435 100 \u0437\u043E\u043B\u043E\u0442\u044B\u0445 \u044F \u0441\u043C\u043E\u0433\u0443
      \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u043E\u0434\u043D\u0443 \u0438\u0437
      \u0442\u0432\u043E\u0438\u0445 \u043A\u0430\u0440\u0442. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0432\u043F\u0435\u0440\u0435\u0434,
      \u0438\u0434\u0435\u0442?!"
    DisplayTime: 2
    IsPlayerLine: 0
  Choices:
  - ChoiceText: "\u041D\u0435\u0442, \u0441\u043F\u0430\u0441\u0438\u0431\u043E,
      \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0447\u0443 \u0432\u044B\u0439\u0442\u0438"

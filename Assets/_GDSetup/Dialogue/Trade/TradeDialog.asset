  SequenceID: trade
  Lines:
  - CharacterName: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446"
    Text: "\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435
      \u0432\u0435\u0449\u0438 \u0438 \u043A\u0430\u0440\u0442\u044B \u0434\u043B\u044F
      \u0442\u0435\u0431\u044F? \u041C\u043E\u0436\u0435\u0442 \u0432\u0437\u0433\u043B\u044F\u043D\u0435\u0448\u044C?"
    DisplayTime: 1
    IsPlayerLine: 0
  - CharacterName: "\u0418\u0433\u0440\u043E\u043A"
    Text: "\u0414\u0430, \u0431\u044B\u043B\u043E \u0431\u044B \u043D\u0435\u043F\u043B\u043E\u0445\u043E
      \u0443\u0441\u0438\u043B\u0438\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0431\u0438\u0442\u0432\u044B...
      \u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0439."
    DisplayTime: 1
    IsPlayerLine: 1
  - CharacterName: "\u041C\u0430\u0441\u0442\u0435\u0440"
    Text: "\u042D\u0442\u0430 \u043D\u043E\u0432\u0430\u044F \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u0435 \u0432
      \u043D\u043E\u0432\u043E\u043C \u0431\u043E\u044E. \u0421\u0442\u043E\u0438\u0442
      \u0432\u0441\u0435\u0433\u043E 300 \u043C\u043E\u043D\u0435\u0442. \u041F\u043E\u043A\u0443\u043F\u0430\u0435\u0448\u044C?"
    DisplayTime: 1
    IsPlayerLine: 0
  Choices:
  - ChoiceText: "\u041D\u0435\u0442, \u0441\u043F\u0430\u0441\u0438\u0431\u043E,
      \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0447\u0443 \u0432\u044B\u0439\u0442\u0438"
    NextSequence: trade_no
    IsEnabled: 1
  - ChoiceText: "\u0414\u0430\u0432\u0430\u0439"
    NextSequence: trade_yes

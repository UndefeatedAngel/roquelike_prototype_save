  - CharacterName: "\u0418\u0433\u0440\u043E\u043A"
    Text: "\u041D\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u043B \u043B\u0438 \u0442\u044B
      \u043A\u043B\u044E\u0447? \u041E\u043D \u0431\u044B \u043F\u043E\u043C\u043E\u0433
      \u043D\u0430\u043C \u0432\u044B\u0439\u0442\u0438 \u043E\u0442\u0441\u044E\u0434\u0430"

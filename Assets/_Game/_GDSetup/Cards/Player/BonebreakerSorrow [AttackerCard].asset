  _nameCard: "\u041A\u043E\u0441\u0442\u043E\u043B\u043E\u043C \u0421\u043A\u043E\u0440\u0431\u0438"
  _descriptionCard: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u043E\u043D \u0431\u044B\u043B
    \u043F\u0430\u043B\u0430\u0447\u043E\u043C \u043F\u043E \u0438\u043C\u0435\u043D\u0438
    \u0423\u043B\u044C\u0440\u0438\u043A, \u043F\u043E\u043A\u0430 \u0435\u0434\u0438\u043D\u044B\u0439
    \u0441\u0442\u043E\u043D \u0435\u0433\u043E \u0436\u0435\u0440\u0442\u0432 \u043D\u0435
    \u0432\u044B\u0436\u0435\u0433 \u0435\u043C\u0443 \u0433\u043B\u0430\u0437\u0430
    \u0438 \u043D\u0435 \u0434\u0430\u0440\u043E\u0432\u0430\u043B \xAB\u043A\u043E\u0441\u0442\u044F\u043D\u043E\u0435
    \u0437\u0440\u0435\u043D\u0438\u0435\xBB. \u0422\u0435\u043F\u0435\u0440\u044C
    \u043E\u043D \u0441\u043A\u0438\u0442\u0430\u0435\u0442\u0441\u044F, \u043F\u043E\u0432\u0438\u043D\u0443\u044F\u0441\u044C
    \u0448\u0451\u043F\u043E\u0442\u0443 \u0447\u0443\u0436\u0438\u0445 \u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432,
    \u043D\u0430\u0445\u043E\u0434\u044F \u0443\u0440\u043E\u0434\u043B\u0438\u0432\u043E\u0435
    \u0443\u0442\u0435\u0448\u0435\u043D\u0438\u0435 \u0432 \u043C\u0443\u0437\u044B\u043A\u0435
    \u043B\u043E\u043C\u0430\u044E\u0449\u0438\u0445\u0441\u044F \u043A\u043E\u0441\u0442\u0435\u0439.\n\n\u041C\u041E\u0411
    \u041A\u0410\u0420\u0422\u042B \u041E\u0427\u0415\u041D\u042C \u041C\u041E\u0416\u041D\u041E
    \u0410\u0422\u0410\u041A\u0423\u0415\u0422. "

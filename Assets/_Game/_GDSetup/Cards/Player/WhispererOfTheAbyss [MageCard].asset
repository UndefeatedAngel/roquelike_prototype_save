  _nameCard: "\u0428\u0435\u043F\u0447\u0443\u0449\u0438\u0439 \u0441 \u0411\u0435\u0437\u0434\u043D\u043E\u0439"
  _descriptionCard: "\u0410\u0441\u0442\u0440\u043E\u043D\u043E\u043C \u041B\u043E\u0440\u0438\u044D\u043D
    \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u043B \u0432 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F
    \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0433\u043B\u0443\u0431\u043E\u043A\u043E
    \u0438 \u0443\u0437\u0440\u0435\u043B \u043D\u0435 \u0437\u0432\u0435\u0437\u0434\u044B,
    \u0430 \u0441\u043F\u044F\u0449\u0435\u0433\u043E \u0431\u043E\u0433\u0430 \u0432
    \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0443\u0441\u0442\u043E\u0442\u0435.
    \u0422\u0435\u043F\u0435\u0440\u044C \u0411\u0435\u0437\u0434\u043D\u0430 \u0448\u0435\u043F\u0447\u0435\u0442
    \u0435\u043C\u0443, \u0438\u0441\u043A\u0430\u0436\u0430\u044F \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0432\u043E\u043A\u0440\u0443\u0433.\n\n\u041C\u041E\u0411 \u042D\u0422\u041E\u0419
    \u041A\u0410\u0420\u0422\u042B \u041C\u041E\u0416\u0415\u0422 \u041D\u0410\u041A\u041B\u0410\u0414\u042B\u0412\u0410\u0422\u042C
    \u041F\u041E\u0417\u0418\u0422\u0418\u0412\u041D\u042B\u0415 \u0418 \u041D\u0415\u0413\u0410\u0422\u0418\u0412\u041D\u042B\u0415
    \u042D\u0424\u0424\u0415\u041A\u0422\u042B."

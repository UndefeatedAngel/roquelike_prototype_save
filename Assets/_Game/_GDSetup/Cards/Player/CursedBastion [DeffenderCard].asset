  _cardId: player_card_protection_01
  _nameCard: "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0439 \u0411\u0430\u0441\u0442\u0438\u043E\u043D"
  _descriptionCard: "\u042D\u0442\u043E \u2014 \u0434\u0443\u0448\u0430 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438
    \xAB\u0412\u0430\u043B \u041E\u0442\u0447\u0430\u044F\u043D\u0438\u044F\xBB,
    \u043E\u0436\u0438\u0432\u043B\u0451\u043D\u043D\u0430\u044F \u0432 \u043C\u043E\u043C\u0435\u043D\u0442
    \u0435\u0451 \u043F\u0430\u0434\u0435\u043D\u0438\u044F. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
    \u043C\u043E\u043B\u0438\u0442\u0432\u0430 \u043A\u0430\u043F\u0435\u043B\u043B\u0430\u043D\u0430
    \u043F\u0440\u0438\u0437\u0432\u0430\u043B\u0430 \u0435\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
    \u0441\u043F\u0430\u0441\u0442\u0438 \u0441\u0442\u0435\u043D\u044B \u0446\u0435\u043D\u043E\u0439
    \u0434\u0443\u0448 \u0432\u0441\u0435\u0445, \u043A\u0442\u043E \u0432\u043D\u0443\u0442\u0440\u0438.
    \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D \u0438\u0449\u0435\u0442, \u043A\u043E\u0433\u043E
    \u0431\u044B \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
    \u0443\u0442\u043E\u043B\u0438\u0442\u044C \u0432\u0435\u0447\u043D\u044B\u0439
    \u0433\u043E\u043B\u043E\u0434.\n\n\u041C\u041E\u0411 \u041A\u0410\u0420\u0422\u042B
    \u0414\u041E\u041F\u041E\u041B\u041D\u0418\u0422\u0415\u041B\u042C\u041D\u041E
    \u0421\u0422\u0410\u0412\u0418\u0422 \u0417\u0410\u0429\u0418\u0422\u0423."

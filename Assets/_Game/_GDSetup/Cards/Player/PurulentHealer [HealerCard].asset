  _cardId: player_card_health_01
  _nameCard: "\u0413\u043D\u043E\u0439\u043D\u044B\u0439 \u041B\u0435\u043A\u0430\u0440\u044C"
  _descriptionCard: "\u0418\u0437\u0433\u043D\u0430\u043D\u043D\u044B\u0439 \u0430\u043B\u0445\u0438\u043C\u0438\u043A
    \u0410\u043B\u044C\u0431\u0435\u0440\u0438\u043A \u043E\u0442\u043A\u0440\u044B\u043B,
    \u0447\u0442\u043E \u0436\u0438\u0437\u043D\u044C \u0438 \u0441\u043C\u0435\u0440\u0442\u044C
    \u2014 \u0434\u0432\u0435 \u0441\u0442\u0430\u0434\u0438\u0438 \u043E\u0434\u043D\u043E\u0433\u043E
    \u0433\u043D\u0438\u0435\u043D\u0438\u044F. \u041E\u043D \xAB\u0438\u0441\u0446\u0435\u043B\u044F\u0435\u0442\xBB,
    \u043F\u043E\u0434\u0441\u0435\u043B\u044F\u044F \u0432 \u0440\u0430\u043D\u044B
    \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u043C\u0443\u044E \u043F\u043B\u0435\u0441\u0435\u043D\u044C
    \u0438 \u043D\u0435\u043A\u0440\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0431\u0438\u043E\u043C\u0430\u0441\u0441\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043F\u043E\u0436\u0438\u0440\u0430\u0435\u0442 \u0438\u043D\u0444\u0435\u043A\u0446\u0438\u044E
    \u0438 \u0447\u0438\u043D\u0438\u0442 \u043F\u043B\u043E\u0442\u044C, \u043E\u0431\u0440\u0435\u043A\u0430\u044F
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430 \u043D\u0430 \u0432\u0435\u0447\u043D\u0443\u044E
    \u0431\u043E\u043B\u044C \u0432 \u043E\u0431\u043C\u0435\u043D \u043D\u0430 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435.\n\n\u041C\u041E\u0411
    \u041A\u0410\u0420\u0422\u042B \u0418\u041C\u0415\u0415\u0422 \u0412\u041E\u0417\u041C\u041E\u0416\u041D\u041E\u0421\u0422\u042C
    \u041B\u0415\u0427\u0418\u0422\u042C."

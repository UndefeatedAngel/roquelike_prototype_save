--- !u!114 &5363558655331980282
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7706711376122751419}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4075c36a453e408a95996f07e5981839, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  titleTextUI: {fileID: 1075375427356073990}
  descriptionTextUI: {fileID: 7172539403710705499}
  canvasGroup: {fileID: 2962557537659815872}
  tipsList:
  - "\u041D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438 \u043C\u0438\u043C\u043E
    \u043A\u043E\u0441\u0442\u0440\u0430. \u041F\u043B\u0430\u043C\u044F \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0433\u0440\u0435\u0432\u0430\u0435\u0442,
    \u043D\u043E \u0438 \u0437\u0430\u043B\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u0440\u0430\u043D\u044B. \u041B\u0443\u0447\u0448\u0435 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C
    \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u043E\u0442\u0434\u044B\u0445, \u0447\u0435\u043C
    \u0432\u043E\u0439\u0442\u0438 \u0432 \u0431\u043E\u0439 \u043E\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u043D\u044B\u043C."
  - "\u0415\u0441\u043B\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043D\u0430
    \u0438\u0441\u0445\u043E\u0434\u0435, \u0438\u0437\u0431\u0435\u0433\u0430\u0439
    \u043A\u043E\u043C\u043D\u0430\u0442 \u0441 \u0432\u0440\u0430\u0433\u0430\u043C\u0438.
    \u0418\u0449\u0438 \u0441\u0443\u043D\u0434\u0443\u043A\u0438 \u0438\u043B\u0438
    \u0442\u0430\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
    - \u043E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u0434\u0430\u0442\u044C
    \u0448\u0430\u043D\u0441 \u043D\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435."
  - "'Unknow' \u043C\u043E\u0436\u0435\u0442 \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C
    \u0447\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E. \u0418\u0434\u0438 \u0442\u0443\u0434\u0430,
    \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0433\u043E\u0442\u043E\u0432
    \u043A \u0445\u0443\u0434\u0448\u0435\u043C\u0443. \u0418\u043D\u043E\u0433\u0434\u0430
    \u043B\u0443\u0447\u0448\u0435 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0443\u044E
    \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C."
  - "\u041A\u0430\u0436\u0434\u0430\u044F \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u0430\u044F
    \u0434\u0443\u0448\u0430 - \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043A\u043B\u044E\u0447 \u043E\u0442 \u0434\u0432\u0435\u0440\u0438. \u0411\u0435\u0437
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u0436\u0435\u0440\u0442\u0432 \u0442\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0448\u044C
    \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u044B\u0435
    \u043A\u0430\u0440\u0442\u044B \u0432 \u0431\u043E\u044E. \u0421\u043E\u0431\u0438\u0440\u0430\u0439
    \u0432\u0441\u0435\u0445."
  - "\u041F\u043E\u043C\u043D\u0438: \u0447\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
    \u0434\u0443\u0448 \u0442\u044B \u0441\u043E\u0431\u0435\u0440\u0435\u0448\u044C,
    \u0442\u0435\u043C \u043C\u043E\u0449\u043D\u0435\u0435 \u0431\u0443\u0434\u0435\u0442
    \u0442\u0432\u043E\u044F \u043A\u043E\u043B\u043E\u0434\u0430. \u0418\u043D\u043E\u0433\u0434\u0430
    \u0441\u0442\u043E\u0438\u0442 \u043E\u0431\u043E\u0439\u0442\u0438 \u043B\u0438\u0448\u043D\u044E\u044E
    \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u0440\u0430\u0434\u0438 \u0435\u0449\u0435
    \u043E\u0434\u043D\u043E\u0439 \u0436\u0435\u0440\u0442\u0432\u044B."
  - "\u041A\u043B\u044E\u0447 \u043E\u0442 \u0441\u0443\u043D\u0434\u0443\u043A\u0430
    \u0441\u043F\u0440\u044F\u0442\u0430\u043D \u0432 \u043E\u0434\u043D\u043E\u0439
    \u0438\u0437 \u043A\u0430\u043C\u0435\u0440. \u0412\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u0432\u0441\u0435 \u043A\u043B\u0435\u0442\u043A\u0438
    - \u043E\u043D \u043C\u043E\u0436\u0435\u0442 \u043B\u0435\u0436\u0430\u0442\u044C
    \u0432 \u0442\u0435\u043C\u043D\u043E\u043C \u0443\u0433\u043B\u0443 \u0438\u043B\u0438
    \u0437\u0430 \u043A\u043E\u0441\u0442\u044F\u043C\u0438."
  - "\u042D\u043B\u0438\u0442\u043D\u044B\u0435 \u0432\u0440\u0430\u0433\u0438 \u0441\u0438\u043B\u044C\u043D\u0435\u0435
    \u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u0441\u0442\u0440\u0430\u0436\u0435\u0439,
    \u043D\u043E \u0438 \u043D\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u043F\u043E\u0431\u0435\u0434\u0443
    \u0432\u044B\u0448\u0435. \u0421\u0440\u0430\u0436\u0430\u0439\u0441\u044F \u0441
    \u043D\u0438\u043C\u0438, \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438
    \u0443\u0432\u0435\u0440\u0435\u043D \u0432 \u0441\u0432\u043E\u0438\u0445 \u0441\u0438\u043B\u0430\u0445."
  - "\u041F\u043E\u0431\u0435\u0434\u0430 \u043D\u0430\u0434 \u044D\u043B\u0438\u0442\u043D\u044B\u043C
    \u0432\u0440\u0430\u0433\u043E\u043C \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438
    \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B.
    \u041D\u043E \u0443\u0431\u0435\u0434\u0438\u0441\u044C, \u0447\u0442\u043E \u0443
    \u0442\u0435\u0431\u044F \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0434\u043B\u044F \u0442\u0430\u043A\u043E\u0439
    \u0431\u0438\u0442\u0432\u044B."
  - "\u041F\u0435\u0440\u0435\u0434 \u043A\u043E\u043C\u043D\u0430\u0442\u043E\u0439
    \u0441 \u0431\u043E\u0441\u0441\u043E\u043C \u0443\u0431\u0435\u0434\u0438\u0441\u044C,
    \u0447\u0442\u043E \u0441\u043E\u0431\u0440\u0430\u043B \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0434\u0443\u0448
    \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435.
    \u042D\u0442\u0430 \u0431\u0438\u0442\u0432\u0430 \u0440\u0435\u0448\u0438\u0442
    \u0432\u0441\u0435."
  - "\u0415\u0441\u043B\u0438 \u0432\u0438\u0434\u0438\u0448\u044C \u043A\u043E\u0441\u0442\u0435\u0440
    \u043F\u0435\u0440\u0435\u0434 \u043A\u043E\u043C\u043D\u0430\u0442\u043E\u0439
    \u0441 \u0431\u043E\u0441\u0441\u043E\u043C - \u044D\u0442\u043E \u0443\u0434\u0430\u0447\u0430.
    \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438 \u0441\u0438\u043B\u044B
    \u0438 \u0438\u0434\u0438 \u043D\u0430 \u0440\u0435\u0448\u0430\u044E\u0449\u0443\u044E
    \u0431\u0438\u0442\u0432\u0443 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C."
  fixedTitle: "\u0421\u043E\u0432\u0435\u0442 \u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0439
    \u0414\u0443\u0448\u0438:"
  tipChangeInterval: 4
  fadeDuration: 2
